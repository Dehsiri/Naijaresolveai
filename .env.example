# Supabase Configuration (Required from Step 2 onwards)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM API Key (Required from Step 6 onwards — OpenAI / Gemini / Groq compatible)
LLM_API_KEY=your-llm-api-key

# Automation Webhook URL (Required in Step 8 — Make.com webhook or optional)
AUTOMATION_WEBHOOK_URL=https://hook.eu1.make.com/your-webhook-id

